# KaziSpace API Configuration
# Bootstrap / directory refresh / live-host fallback only (KAZI-533).
# Account API hosts come from the bundled region directory + session.home_api_base.
NEXT_PUBLIC_API_BASE_URL=https://bot.kazispace.ai
# Staging/preview only: allow OTP to not_ready CN (api-cn). NEVER set on production.
# NEXT_PUBLIC_REGION_ALLOW_NOT_READY=1
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Agent Hub: auto-mock on 404 until backend §13 is live. Force mock with:
# NEXT_PUBLIC_AGENT_API_MOCK=true
# Phase 1.5 IRP Profile UI — enable when KAZI-58 staging is live (API §7.7)
# NEXT_PUBLIC_IRP_PROFILE_ENABLED=true
# Phase 1 EPP English Tutor — enable when KAZI-64 staging is live (API §14)
# NEXT_PUBLIC_EPP_PROFILE_ENABLED=true
# ADR-006 Kazi Spaces — enabled in netlify.toml when BE SPACES_ENABLED is on (KAZI-172)
# NEXT_PUBLIC_SPACES_ENABLED=true
# P0 workspace asset rail v2 (KAZI-404) — resume file icons via GET /workspace-assets
# NEXT_PUBLIC_WORKSPACE_ASSET_RAIL_V2=true
# POST /reindex not in BE #301 — enable when endpoint ships
# NEXT_PUBLIC_WORKSPACE_ASSET_REINDEX_ENABLED=true
