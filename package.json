  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run && bash scripts/grep-region-api-base.sh && node scripts/sync-region-directory.mjs --check",
