    "clsx": "^2.1.1",
    "lucide-react": "^0.424.0",
    "next": "14.2.5",
    "next-intl": "^3.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
