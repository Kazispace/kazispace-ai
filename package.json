    "gen:api": "openapi-typescript docs/openapi.json -o src/types/api.generated.ts",
    "gen:api:full": "npm run sync:openapi && npm run gen:api",
    "smoke": "bash scripts/smoke.sh",
    "smoke:health": "bash scripts/smoke-health.sh",
    "smoke:routes": "bash scripts/smoke-routes.sh",
    "smoke:cv-upload": "bash scripts/smoke-cv-upload.sh"
