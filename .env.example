# KaziSpace API
KAZI_API_BASE_URL=https://bot.kazispace.ai

# OTP mock mode uses fixed code from otp/request response (_mock_code)
KAZI_OTP_MOCK_CODE=123456

# Stress test: number of concurrent users (max 10 in default scenario)
STRESS_USER_COUNT=10

# Monkey test duration in seconds
MONKEY_DURATION_SEC=60

# Optional: override single test user
# KAZI_TEST_PHONE=+77015551234
